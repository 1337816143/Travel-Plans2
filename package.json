{
  "name": "global-travel-guide",
  "version": "0.1.0",
  "private": true,
  "description": "全球旅行攻略：全球地点数据、可信内容和多端旅行规划平台",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=20.9.0"
  },
  "packageManager": "pnpm@10.14.0",
  "scripts": {
    "build": "pnpm -r --if-present build",
    "dev": "pnpm --filter @travel/web dev",
    "dev:miniapp": "pnpm --filter @travel/miniapp dev:weapp",
    "test": "pnpm -r --if-present test",
    "test:core": "vitest run packages/domain packages/planner-engine packages/provider-contracts",
    "typecheck": "pnpm -r --if-present typecheck",
    "lint": "pnpm -r --if-present lint",
    "check": "pnpm typecheck && pnpm test"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsx": "^4.20.3",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
